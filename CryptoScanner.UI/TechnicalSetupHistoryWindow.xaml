<Window x:Class="CryptoScanner.UI.TechnicalSetupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Setups Técnicos" Height="520" Width="980"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#F5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Situações observadas em candles fechados. Não são sinais de trade e não representam recomendação de entrada."
                   Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="1" x:Name="dgSetups" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#252525" Foreground="#F5F5F5" RowBackground="#252525" AlternatingRowBackground="#1E1E1E"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#454545" VerticalGridLinesBrush="#454545">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#282828"/><Setter Property="Foreground" Value="#00D7D7"/><Setter Property="Padding" Value="5,3"/></Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Candle" Binding="{Binding CandleLocal, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                <DataGridTextColumn Header="Ativo" Binding="{Binding Symbol}" Width="105"/>
                <DataGridTextColumn Header="Lado" Binding="{Binding Direction}" Width="70"/>
                <DataGridTextColumn Header="Setup" Binding="{Binding Setup}" Width="220"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding Price, StringFormat=0.########}" Width="120"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F2}" Width="75"/>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="90"/>
                <DataGridTextColumn Header="Regime" Binding="{Binding MarketRegime}" Width="90"/>
                <DataGridTextColumn Header="Registrado" Binding="{Binding RecordedUtc, StringFormat=dd/MM HH:mm}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
