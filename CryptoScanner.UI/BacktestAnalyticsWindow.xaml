<Window x:Class="CryptoScanner.UI.BacktestAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        Title="Análise por Fator — Backtest" Height="800" Width="1300"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Reaproveita o mesmo conversor já usado no BacktestWindow (classe pública,
             mesma assembly/namespace) — verde quando positivo, vermelho quando negativo.
             Funciona tanto pro Edge (double) quanto aqui pro Retorno Médio (double). -->
        <local:EdgeColorConverter x:Key="EdgeColorConverter"/>

        <!-- Estilo compartilhado por todos os DataGrids de bucket abaixo — mesmas 4
             colunas (Faixa/Categoria, N, Win Rate %, Retorno Médio %) em todo lugar. -->
        <Style x:Key="BucketGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="MaxHeight" Value="230"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="txtSummary" FontWeight="Bold" FontSize="13"/>
            <TextBlock FontSize="11" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="A leitura desses números depende dos limiares usados no teste: se o teste rodou com limiares SOLTOS (exploração), isso ajuda a descobrir fatores novos. Se rodou com os limiares VALIDADOS (restritivos), a amostra por faixa tende a ficar pequena e as variáveis já filtradas (ex.: RR, Score) ficam sem variação suficiente pra análise."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">

                <GroupBox Header="Por Score" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgScore" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por RSI" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgRsi" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por ADX" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgAdx" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por ATR %" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgAtr" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Risk/Reward de Entrada" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgRiskReward" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Padrão de Candle" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgPattern" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Padrão" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Smart Money" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgSmartMoney" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rótulo" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Fonte do Rompimento" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgBreakoutSource" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Regime de Mercado" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgRegime" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Regime" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Direção" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgDirection" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Direção" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Por Motivo de Saída" Margin="0,0,10,10" Width="380">
                    <DataGrid x:Name="dgExitReason" Style="{StaticResource BucketGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="50"/>
                            <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                            <DataGridTextColumn Header="Retorno Médio %" Binding="{Binding AvgReturn, StringFormat=F2}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AvgReturn, Converter={StaticResource EdgeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Window>
