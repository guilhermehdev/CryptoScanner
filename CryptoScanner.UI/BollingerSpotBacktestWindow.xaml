<Window x:Class="CryptoScanner.UI.BollingerSpotBacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backtest Spot · Bandas de Bollinger" Width="1180" Height="780"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Bollinger Spot · experimento" FontSize="23" FontWeight="SemiBold"/>
        <WrapPanel Grid.Row="1" Margin="0,14,0,12">
            <TextBlock Text="Variante:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="variant" Width="175" SelectedIndex="1">
                <ComboBoxItem Content="Desativada" Tag="Disabled"/>
                <ComboBoxItem Content="Bollinger 20/3" Tag="Bollinger20x3"/>
                <ComboBoxItem Content="Bollinger 20/2,3" Tag="Bollinger20x23"/>
                <ComboBoxItem Content="Bollinger 25/3" Tag="Bollinger25x3"/>
                <ComboBoxItem Content="Bollinger 25/2,3" Tag="Bollinger25x23"/>
            </ComboBox>
            <TextBlock Text="Timeframe:" VerticalAlignment="Center" Margin="18,0,6,0"/>
            <ComboBox x:Name="timeframe" Width="105" SelectedIndex="1">
                <ComboBoxItem Content="4 horas" Tag="FourHours"/>
                <ComboBoxItem Content="Diário" Tag="Daily"/>
            </ComboBox>
            <TextBlock Text="Ativos:" VerticalAlignment="Center" Margin="18,0,6,0"/>
            <CheckBox x:Name="top30Liquidity" Content="30 mais líquidos na Binance" IsChecked="True" VerticalAlignment="Center"/>
            <TextBox x:Name="symbols" Width="210" Margin="10,0,0,0" Text="BTCUSDT,ETHUSDT,SOLUSDT"
                     ToolTip="Usado somente se desmarcar os 30 mais líquidos."/>
            <TextBlock Text="Início:" VerticalAlignment="Center" Margin="18,0,6,0"/>
            <DatePicker x:Name="start" Width="125"/>
            <TextBlock Text="Fim:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <DatePicker x:Name="end" Width="125"/>
            <Button x:Name="run" Content="Rodar backtest" Click="Run_Click" Padding="14,4" Margin="18,0,0,0"/>
        </WrapPanel>
        <Border Grid.Row="2" Background="#252525" BorderBrush="#444" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="summary" TextWrapping="Wrap" Foreground="#D8D8D8"
                       Text="Spot experimental: candle fechado fora da banda cria setup; compra só rompe a máxima e venda só fecha uma posição LONG ao perder a mínima. Stop e alvo são estruturais."/>
        </Border>
        <DataGrid x:Name="trades" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ativo" Binding="{Binding Symbol}" Width="100"/>
                <DataGridTextColumn Header="Variante" Binding="{Binding Settings.DisplayName}" Width="190"/>
                <DataGridTextColumn Header="Setup UTC" Binding="{Binding SetupTimeUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                <DataGridTextColumn Header="Entrada UTC" Binding="{Binding EntryTimeUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                <DataGridTextColumn Header="Entrada" Binding="{Binding EntryPrice, StringFormat=0.########}" Width="105"/>
                <DataGridTextColumn Header="Stop" Binding="{Binding Stop, StringFormat=0.########}" Width="105"/>
                <DataGridTextColumn Header="Alvo (média)" Binding="{Binding Target, StringFormat=0.########}" Width="120"/>
                <DataGridTextColumn Header="Saída" Binding="{Binding ExitPrice, StringFormat=0.########, TargetNullValue=Aberta}" Width="105"/>
                <DataGridTextColumn Header="Resultado %" Binding="{Binding ReturnPercent, StringFormat=F2, TargetNullValue=—}" Width="95"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding ExitReason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
