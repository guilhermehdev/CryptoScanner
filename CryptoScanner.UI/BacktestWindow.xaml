<Window x:Class="CryptoScanner.UI.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        Title="Backtest Completo" Height="820" Width="1350"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:EdgeColorConverter x:Key="EdgeColorConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Bloco 1: Período & Perfil -->
        <GroupBox Grid.Row="0" Header="Período &amp; Perfil" Margin="0,0,0,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,6,6,4">
                    <TextBlock Text="Início:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpStart" Width="130" Margin="0,0,20,0"/>
                    <TextBlock Text="Fim:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpEnd" Width="130" Margin="0,0,20,0"/>
                    <TextBlock Text="Anos de histórico:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray"/>
                    <TextBox x:Name="txtYearsBack" Width="40" Text="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="Preencher" Height="22" Padding="8,0" Click="BtnFillYears_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                    <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="rbBacktestIntraday" Content="Intraday (1h / 24h)" GroupName="BacktestProfile" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbBacktestSwing" Content="Swing (4h / 10 dias)" GroupName="BacktestProfile" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbBacktestScalp" Content="Scalp (15min / 6h, não validado)" GroupName="BacktestProfile" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <TextBlock Text="Direção:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="rbDirectionLong" Content="Compra (Long)" GroupName="TradeDirection" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbDirectionShort" Content="Venda (Short, Fase 1 — só &quot;Rodar Backtest&quot;)" GroupName="TradeDirection" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!-- Bloco 2: Moedas -->
        <GroupBox Grid.Row="1" Header="Moedas" Margin="0,0,0,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,6,6,4">
                    <RadioButton x:Name="rbManual" Content="Manual:" GroupName="SymbolMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtManualSymbols" Width="280" Text="BTCUSDT,ETHUSDT,SOLUSDT" Margin="0,0,6,0" VerticalAlignment="Center" TextChanged="TxtManualSymbols_TextChanged"/>
                    <TextBlock x:Name="txtManualSymbolsCount" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbAuto" Content="Top automático:" GroupName="SymbolMode" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtTopN" Width="50" Text="20" VerticalAlignment="Center"/>
                    <TextBlock Text="moedas por volume atual" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                    <TextBlock Text="Histórico mín. (anos):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
                    <TextBox x:Name="txtHistoryYears" Width="35" Text="5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Congelar moedas" Height="22" Padding="8,0" Margin="0,0,20,0" Click="BtnFreezeWithFullHistory_Click"/>
                    <Button Content="Histórico de Testes" Height="22" Padding="8,0" Click="BtnBacktestHistory_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!-- Bloco 3: Limiares & Modo de Risco -->
        <GroupBox Grid.Row="2" Header="Limiares deste teste &amp; Modo de Risco" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="6,6,6,4">
                    <TextBlock Text="Score mín.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinScore" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Dist. Resist. mín. Swing %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinResistDistance" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Dist. Resist. mín. ATR %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinResistDistanceAtr" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Dist. Resist. mín. Pontuada %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinResistDistancePartialExits" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Volume Spike mín.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinVolumeSpike" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Risk/Reward mín.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinRiskReward" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Risk/Reward máx.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMaxRiskReward" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Stop mín. %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMinStopDistance" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Stop máx. %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtMaxStopDistance" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Timeout (h, vazio=padrão):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtEvaluationHoursOverride" Width="55" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="chkDisableTimeout" Content="Sem timeout — só TP/SL" VerticalAlignment="Center"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal" Margin="6,0,6,6">
                    <TextBlock Text="Cálculo de Risco:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="rbRiskPartialExits" Content="Swing + Resistência Pontuada (4.1)" GroupName="RiskMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbRiskMeanReversion" Content="Reversão à Média (Scalp, não validado)" GroupName="RiskMode" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbRiskBollingerReversal" Content="Reversão de Bollinger (Venda, não validado)" GroupName="RiskMode" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <CheckBox x:Name="chkEnableVolatilityScoringPhaseB" Content="Volatility Scoring — Fase B (experimental)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkEnableMultiTimeframe" Content="Multi-timeframe (4.2, experimental)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkEnablePullbackBounce" Content="Caminho A — Repique (pullback, experimental)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkEnableMeanReversionScalp" Content="Reversão à Média (Scalp, experimental)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkBlockMeanReversionInBear" Content="Bloquear Reversão à Média em BEAR (experimental)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkLimitAtrForMeanReversion" Content="Limitar ATR% no Reversão à Média (experimental)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkEnableBollingerReversal" Content="Reversão de Bollinger (Venda, experimental)" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <!-- Bloco 4: Ações -->
        <GroupBox Grid.Row="3" Header="Ações" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="6,6,6,4">
                    <Button x:Name="btnRun" Content="Rodar Backtest" Width="130" Height="26" Click="BtnRun_Click"/>
                    <Button x:Name="btnCancel" Content="Cancelar" Width="90" Height="26" Margin="8,0,0,0" IsEnabled="False" Click="BtnCancel_Click"/>
                    <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
                </WrapPanel>
                <ProgressBar x:Name="pbProgress" Height="6" Margin="6,0,6,8" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <TextBlock Text="Padrão Scanner (múltiplos períodos, configuração real do app ao vivo):" Margin="6,0,6,2" FontWeight="Bold" FontSize="11"/>
                <WrapPanel Margin="6,0,6,2">
                    <TextBlock Text="Anos por período:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtPeriodYears" Width="40" Text="1" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Quantidade de períodos:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtPeriodCount" Width="40" Text="4" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="btnComparePeriods" Content="Rodar Padrão Scanner" Height="26" Padding="8,0" Click="BtnComparePeriods_Click"/>
                </WrapPanel>
                <TextBlock Margin="6,2,6,6" FontSize="10" FontStyle="Italic" Foreground="Gray"
                           Text="Ignora os limiares configurados acima — usa sempre a configuração padrão exata do ScannerSettings (a mesma do app ao vivo)."/>
            </StackPanel>
        </GroupBox>
        <!-- Bloco 5: Resultados -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Border Background="WhiteSmoke" BorderBrush="LightGray" BorderThickness="1" Padding="10" MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtSummaryResult" FontWeight="Bold" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
                <Button Content="Copiar Resumo" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,4,0" Padding="6,2" FontSize="10" Click="BtnCopySummary_Click"/>
            </Grid>
            <DataGrid x:Name="dgComparison"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Visibility="Collapsed"
                  MaxHeight="180"
                  Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cenário" Binding="{Binding Label}" Width="140"/>
                    <DataGridTextColumn Header="Operações" Binding="{Binding TotalTrades}" Width="90"/>
                    <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                    <DataGridTextColumn Header="Retorno %" Binding="{Binding TotalReturnPercent, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Drawdown %" Binding="{Binding MaxDrawdownPercent, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="Profit Factor" Binding="{Binding ProfitFactor, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="RR Médio" Binding="{Binding AvgRiskRewardAtEntry, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Win Rate Equilíbrio %" Binding="{Binding BreakEvenWinRate, StringFormat=F1}" Width="140"/>
                    <DataGridTextColumn Header="Edge (pontos %)" Binding="{Binding Edge, StringFormat=F1}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Edge, Converter={StaticResource EdgeColorConverter}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Background="White" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Curva de Retorno Acumulado (por ordem cronológica de saída)"
                           FontWeight="Bold" FontSize="11" Margin="6,4,0,0"/>
                    <Canvas x:Name="cnvEquityCurve" Height="170" Margin="4" SizeChanged="CnvEquityCurve_SizeChanged"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button x:Name="btnAnalyzeFactors" Content="Análise por Fator" Padding="8,3" Margin="0,0,8,0" Click="BtnAnalyzeFactors_Click"/>
                    <Button x:Name="btnExportTrades" Content="Exportar Trades (CSV)" Padding="8,3" Click="BtnExportTradesCsv_Click"/>
                </StackPanel>
                <DataGrid x:Name="dgTrades" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" Width="90"/>
                        <DataGridTextColumn Header="Direção" Binding="{Binding Direction}" Width="70"/>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding EntryTime, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Preço Entrada" Binding="{Binding EntryPrice}" Width="100"/>
                        <DataGridTextColumn Header="Saída" Binding="{Binding ExitTime, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Preço Saída" Binding="{Binding ExitPrice}" Width="100"/>
                        <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" Width="100"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding ExitReason}" Width="80"/>
                        <DataGridTextColumn Header="Sinal" Binding="{Binding Signal}" Width="90"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Header="Res % (entrada)" Binding="{Binding ResistanceDistancePercent, StringFormat=F1}" Width="110"/>
                        <DataGridTextColumn Header="Sup % (entrada)" Binding="{Binding SupportDistancePercent, StringFormat=F1}" Width="110"/>
                        <DataGridTextColumn Header="RR (entrada)" Binding="{Binding RiskRewardAtEntry, StringFormat=F2}" Width="90"/>
                        <!-- Instrumentação Fase A do lado de venda — só exposição de dado, sem
                         afetar Score/elegibilidade. Sempre em branco/desmarcado pra trades
                         Long (conceito não existe desse lado). -->
                        <DataGridCheckBoxColumn Header="Mom. Baixista" Binding="{Binding HadBearishMomentumConfirmed}" Width="95"/>
                        <DataGridCheckBoxColumn Header="Div. RSI" Binding="{Binding HadBearishRsiDivergence}" Width="80"/>
                        <!-- Diagnóstico: separa "dado indisponível" de "dado disponível mas
                         sinal não ocorreu" nas 2 colunas acima -->
                        <DataGridCheckBoxColumn Header="Dado Disp.?" Binding="{Binding HadSwingHighDataAvailable}" Width="90"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP">
                                    <Setter Property="Background" Value="LightGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="SL">
                                    <Setter Property="Background" Value="LightSalmon"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TIMEOUT">
                                    <Setter Property="Background" Value="LightGray"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="EOT">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2TP3">
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1SL">
                                    <Setter Property="Background" Value="PaleGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2SL">
                                    <Setter Property="Background" Value="PaleGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TIMEOUT">
                                    <Setter Property="Background" Value="Khaki"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2TIMEOUT">
                                    <Setter Property="Background" Value="Khaki"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1EOT">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2EOT">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
