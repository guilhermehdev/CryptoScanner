<Window x:Class="CryptoScanner.UI.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        Title="Backtest Completo" Height="820" Width="1350"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <local:EdgeColorConverter x:Key="EdgeColorConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Bloco 1: Período & Perfil -->
        <GroupBox Grid.Row="0" Header="Período &amp; Perfil" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel Margin="6,6,6,4">
                    <TextBlock Text="Início:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpStart" Width="130" Margin="0,0,20,0"/>
                    <TextBlock Text="Fim:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpEnd" Width="130" Margin="0,0,20,0"/>
                    <CheckBox x:Name="chkChronologicalSplit" Content="Separar períodos" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dpValidationStart" Width="130" Margin="0,0,10,0" ToolTip="Início da validação. Deve estar entre início e fim. Mesmos parâmetros nos dois períodos."/>
                    <TextBlock Text="Anos de histórico:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray"/>
                    <TextBox x:Name="txtYearsBack" Width="40" Text="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="Preencher" Height="22" Padding="8,0" Click="BtnFillYears_Click"/>
                </WrapPanel>
                <WrapPanel Margin="6,0,6,6">
                    <TextBlock Text="Estratégia:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cmbStrategyProfile" Width="205" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="StrategyProfile_Changed" ToolTip="Cada perfil tem um gatilho próprio e é registrado separadamente no histórico.">
                        <ComboBoxItem Content="Breakout Trend"/>
                        <ComboBoxItem Content="Pullback Trend"/>
                        <ComboBoxItem Content="Mean Reversion (experimental)"/>
                    </ComboBox>
                    <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="rbBacktestIntraday" Content="Intraday (1h / 24h)" GroupName="BacktestProfile" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbBacktestSwing" Content="Swing (4h / 10 dias)" GroupName="BacktestProfile" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbBacktestScalp" Content="Scalp (15min / 6h, não validado)" GroupName="BacktestProfile" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <TextBlock Text="Direção:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="rbDirectionLong" Content="Compra (Long)" GroupName="TradeDirection" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbDirectionShort" Content="Venda (Short)" GroupName="TradeDirection" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <!-- Blocos 2–4: configuração principal -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Moedas" Margin="0,0,6,0">
                <StackPanel Margin="8">
                    <RadioButton x:Name="rbManual" Content="Manual" GroupName="SymbolMode" IsChecked="True" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtManualSymbols" Text="BTCUSDT,ETHUSDT,SOLUSDT" HorizontalAlignment="Stretch" Margin="0,0,0,2" TextChanged="TxtManualSymbols_TextChanged"/>
                    <TextBlock x:Name="txtManualSymbolsCount" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>
                    <RadioButton x:Name="rbAuto" Content="Top automático" GroupName="SymbolMode" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="txtTopN" Width="50" Text="20"/>
                        <TextBlock Text="moedas por volume atual" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                    <Separator Margin="0,4,0,8"/>
                    <TextBlock Text="Histórico mínimo (anos)" Foreground="Gray"/>
                    <TextBox x:Name="txtHistoryYears" Width="45" Text="5" HorizontalAlignment="Left" Margin="0,2,0,8"/>
                    <Button Content="Congelar moedas" Height="24" Padding="8,0" HorizontalAlignment="Left" Margin="0,0,0,6" Click="BtnFreezeWithFullHistory_Click"/>
                    <Button Content="Histórico de Testes" Height="24" Padding="8,0" HorizontalAlignment="Left" Click="BtnBacktestHistory_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Modo do teste" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <StackPanel Margin="8">
                        <TextBlock Text="Modo" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbTestMode" SelectedIndex="0" SelectionChanged="TestMode_Changed" Margin="0,2,0,8" ToolTip="Validado reproduz o scanner; Exploração relaxa limites; Diagnóstico abre os limiares quantitativos para medir o funil.">
                            <ComboBoxItem Content="Validado (scanner)"/>
                            <ComboBoxItem Content="Exploração (limiares flexíveis)"/>
                            <ComboBoxItem Content="Diagnóstico (limiares abertos)"/>
                        </ComboBox>
                        <TextBlock Text="Score mínimo"/>
                        <TextBox x:Name="txtMinScore" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Score máximo Short" ToolTip="Experimento: bloqueia Shorts cujo Score efetivo fique acima deste valor. Não afeta Compras."/>
                        <TextBox x:Name="txtMaxShortScore" Width="70" Text="100" HorizontalAlignment="Left" Margin="0,2,0,6" ToolTip="Use 80 para testar o teto experimental de Score nos Shorts."/>
                        <TextBlock Text="ADX máximo Short em BEAR" ToolTip="Experimento: bloqueia Shorts em BEAR quando o ADX ultrapassa este valor. Não afeta Compras ou outros regimes."/>
                        <TextBox x:Name="txtMaxShortAdxBear" Width="70" Text="999" HorizontalAlignment="Left" Margin="0,2,0,6" ToolTip="Use 30 para testar o limite exploratório identificado na auditoria."/>
                        <TextBlock Text="Distância mínima da resistência — Swing (%)"/>
                        <TextBox x:Name="txtMinResistDistance" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Distância mínima da resistência — ATR (%)"/>
                        <TextBox x:Name="txtMinResistDistanceAtr" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Distância mínima da resistência pontuada (%)"/>
                        <TextBox x:Name="txtMinResistDistancePartialExits" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <CheckBox x:Name="chkTargetAtr" Content="Alvo mínimo em ATR" Margin="0,2,0,2" ToolTip="Experimento: substitui a distância percentual pelo múltiplo de ATR abaixo. Não altera o scanner ao vivo."/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                            <TextBlock Text="Múltiplo ATR:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtTargetAtr" Text="1" Width="50" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Volume Spike mínimo"/>
                        <TextBox x:Name="txtMinVolumeSpike" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Risk/Reward mínimo"/>
                        <TextBox x:Name="txtMinRiskReward" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Risk/Reward máximo"/>
                        <TextBox x:Name="txtMaxRiskReward" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Stop mínimo (%)"/>
                        <TextBox x:Name="txtMinStopDistance" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Stop máximo (%)"/>
                        <TextBox x:Name="txtMaxStopDistance" Width="70" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <TextBlock Text="Timeout (horas; vazio = padrão)"/>
                        <TextBox x:Name="txtEvaluationHoursOverride" Width="80" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <CheckBox x:Name="chkDisableTimeout" Content="Sem timeout — só TP/SL" Margin="0,0,0,8"/>
                        <TextBlock Text="Experimento estrutural"/>
                        <ComboBox x:Name="cmbStructureExperiment" SelectedIndex="0" Margin="0,2,0,8">
                            <ComboBoxItem Content="Referência (sem alteração)"/>
                            <ComboBoxItem Content="Teste A: só stop do rompimento"/>
                            <ComboBoxItem Content="Teste B: só confirmação atual do repique"/>
                            <ComboBoxItem Content="Estrutura completa (experimento anterior)"/>
                            <ComboBoxItem Content="Alvo: limite inferior da zona"/>
                            <ComboBoxItem Content="Alvo: limite superior da zona"/>
                            <ComboBoxItem Content="Alvo: extensão após a zona"/>
                        </ComboBox>
                        <Button Content="Copiar parâmetros do scanner" Click="CopyScannerThresholds_Click" Padding="5,2" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Cálculo de risco" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <StackPanel Margin="8">
                        <TextBlock Text="Modo de cálculo" FontWeight="Bold" Margin="0,0,0,6"/>
                        <RadioButton x:Name="rbRiskPartialExits" Content="Swing + Resistência Pontuada (4.1)" GroupName="RiskMode" IsChecked="True" Margin="0,0,0,8"/>
                        <RadioButton x:Name="rbRiskIntradayLocal" Content="Intraday: rompimento + reteste (experimental)" GroupName="RiskMode" Margin="0,0,0,8" ToolTip="Exclusivo do perfil Intraday. Exige rompimento confirmado no candle anterior, reteste no candle atual, stop por invalidação local e alvo 2R. Ainda não validado para uso ao vivo."/>
                        <RadioButton x:Name="rbRiskMeanReversion" Content="Reversão à Média (Scalp, não validado)" GroupName="RiskMode" Margin="0,0,0,8"/>
                        <RadioButton x:Name="rbRiskBollingerReversal" Content="Reversão de Bollinger (Venda, não validado)" GroupName="RiskMode" Margin="0,0,0,10"/>
                        <Separator Margin="0,0,0,8"/>
                        <TextBlock Text="Experimentos" FontWeight="Bold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="chkEnableVolatilityScoringPhaseB" Content="Volatility Scoring — Fase B" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkEnableMultiTimeframe" Content="Multi-timeframe (4.2)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkEnablePullbackBounce" Content="Caminho A — Repique (pullback)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkEnableMeanReversionScalp" Content="Reversão à Média (Scalp)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkBlockMeanReversionInBear" Content="Bloquear Reversão à Média em BEAR" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkLimitAtrForMeanReversion" Content="Limitar ATR% no Reversão à Média" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkEnableBollingerReversal" Content="Reversão de Bollinger (Venda)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkRequireBearishMomentum" Content="Exigir momentum baixista (Short)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkBlockShortInSideways" Content="Bloquear Short em lateral"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        <!-- Bloco 4: Ações -->
        <GroupBox Grid.Row="2" Header="Ações" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="6,6,6,4">
                    <Button x:Name="btnRun" Content="Rodar Backtest" Width="130" Height="26" Click="BtnRun_Click"/>
                    <Button x:Name="btnCancel" Content="Cancelar" Width="90" Height="26" Margin="8,0,0,0" IsEnabled="False" Click="BtnCancel_Click"/>
                    <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
                </WrapPanel>
                <ProgressBar x:Name="pbProgress" Height="6" Margin="6,0,6,8" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <TextBlock Text="Padrão Scanner (múltiplos períodos, configuração real do app ao vivo):" Margin="6,0,6,2" FontWeight="Bold" FontSize="11"/>
                <WrapPanel Margin="6,0,6,2">
                    <TextBlock Text="Anos por período:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtPeriodYears" Width="40" Text="1" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Quantidade de períodos:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtPeriodCount" Width="40" Text="4" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="btnComparePeriods" Content="Rodar Padrão Scanner" Height="26" Padding="8,0" Click="BtnComparePeriods_Click"/>
                </WrapPanel>
                <TextBlock Margin="6,2,6,6" FontSize="10" FontStyle="Italic" Foreground="Gray"
                           Text="Ignora os limiares configurados acima — usa sempre a configuração padrão exata do ScannerSettings (a mesma do app ao vivo)."/>
            </StackPanel>
        </GroupBox>
        <!-- Bloco 5: Resultados -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <Button x:Name="btnAnalyzeFactors" Content="Análise por Fator" Padding="8,3" Margin="0,0,8,0" Click="BtnAnalyzeFactors_Click"/>
                <Button x:Name="btnExportTrades" Content="Exportar Trades (CSV)" Padding="8,3" Click="BtnExportTradesCsv_Click"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" Padding="10" MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtSummaryResult" FontWeight="Bold" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
                <Button Content="Copiar Resumo" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,4,0" Padding="6,2" FontSize="10" Click="BtnCopySummary_Click"/>
            </Grid>
            <DataGrid x:Name="dgComparison"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Visibility="Collapsed"
                  MaxHeight="120"
                  Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cenário" Binding="{Binding Label}" Width="140"/>
                    <DataGridTextColumn Header="Operações" Binding="{Binding TotalTrades}" Width="90"/>
                    <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                    <DataGridTextColumn Header="Soma (p.p.)" Binding="{Binding TotalReturnPercent, StringFormat=F2}" Width="95"/>
                    <DataGridTextColumn Header="Queda soma (p.p.)" Binding="{Binding MaxDrawdownPercent, StringFormat=F2}" Width="125"/>
                    <DataGridTextColumn Header="Profit Factor" Binding="{Binding ProfitFactor, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="RR Médio" Binding="{Binding AvgRiskRewardAtEntry, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Win Rate Equilíbrio %" Binding="{Binding BreakEvenWinRate, StringFormat=F1}" Width="140"/>
                    <DataGridTextColumn Header="Edge (pontos %)" Binding="{Binding Edge, StringFormat=F1}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Edge, Converter={StaticResource EdgeColorConverter}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" BorderBrush="#444444" BorderThickness="1" Background="#252525" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Soma dos retornos por trade (pontos percentuais; não representa o saldo da carteira)"
                           FontWeight="Bold" FontSize="11" Margin="6,4,0,0"/>
                    <Canvas x:Name="cnvEquityCurve" Height="130" Margin="4" SizeChanged="CnvEquityCurve_SizeChanged"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgTrades" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          Foreground="#172033"
                          RowBackground="#F3F4F6"
                          AlternatingRowBackground="#E5E7EB"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#CBD5E1"
                          VerticalGridLinesBrush="#CBD5E1">
                    <DataGrid.Resources>
                        <!-- O tema global usa texto claro para o scanner escuro. Esta grade
                             usa fundos claros nas linhas para manter os trades legíveis. -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="#172033"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" Width="90"/>
                        <DataGridTextColumn Header="Direção" Binding="{Binding Direction}" Width="70"/>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding EntryTime, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Preço Entrada" Binding="{Binding EntryPrice}" Width="100"/>
                        <DataGridTextColumn Header="Saída" Binding="{Binding ExitTime, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Preço Saída" Binding="{Binding ExitPrice}" Width="100"/>
                        <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" Width="100"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding ExitReason}" Width="80"/>
                        <DataGridTextColumn Header="Sinal" Binding="{Binding Signal}" Width="90"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Header="Res % (entrada)" Binding="{Binding ResistanceDistancePercent, StringFormat=F1}" Width="110"/>
                        <DataGridTextColumn Header="Sup % (entrada)" Binding="{Binding SupportDistancePercent, StringFormat=F1}" Width="110"/>
                        <DataGridTextColumn Header="RR (entrada)" Binding="{Binding RiskRewardAtEntry, StringFormat=F2}" Width="90"/>
                        <!-- Instrumentação Fase A do lado de venda — só exposição de dado, sem
                         afetar Score/elegibilidade. Sempre em branco/desmarcado pra trades
                         Long (conceito não existe desse lado). -->
                        <DataGridCheckBoxColumn Header="Mom. Baixista" Binding="{Binding HadBearishMomentumConfirmed}" Width="95"/>
                        <DataGridCheckBoxColumn Header="Div. RSI" Binding="{Binding HadBearishRsiDivergence}" Width="80"/>
                        <!-- Diagnóstico: separa "dado indisponível" de "dado disponível mas
                         sinal não ocorreu" nas 2 colunas acima -->
                        <DataGridCheckBoxColumn Header="Dado Disp.?" Binding="{Binding HadSwingHighDataAvailable}" Width="90"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Foreground" Value="#172033"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP">
                                    <Setter Property="Background" Value="LightGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="SL">
                                    <Setter Property="Background" Value="LightSalmon"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TIMEOUT">
                                    <Setter Property="Background" Value="LightGray"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="EOT">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2TP3">
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1SL">
                                    <Setter Property="Background" Value="PaleGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2SL">
                                    <Setter Property="Background" Value="PaleGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TIMEOUT">
                                    <Setter Property="Background" Value="Khaki"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2TIMEOUT">
                                    <Setter Property="Background" Value="Khaki"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1EOT">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExitReason}" Value="TP1TP2EOT">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
