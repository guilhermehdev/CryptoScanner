<Window x:Class="CryptoScanner.UI.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        Title="Backtest Completo" Height="780" Width="1350"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:EdgeColorConverter x:Key="EdgeColorConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Período -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Início:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
            <DatePicker x:Name="dpStart" Width="130" Margin="0,0,20,0"/>

            <TextBlock Text="Fim:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
            <DatePicker x:Name="dpEnd" Width="130" Margin="0,0,20,0"/>

            <TextBlock Text="Anos de histórico:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray"/>
            <TextBox x:Name="txtYearsBack" Width="40" Text="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button Content="Preencher" Height="22" Padding="8,0" Click="BtnFillYears_Click"/>
        </StackPanel>

        <!-- Perfil -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
            <RadioButton x:Name="rbBacktestIntraday" Content="Intraday (1h / 24h)" GroupName="BacktestProfile" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbBacktestSwing" Content="Swing (4h / 10 dias)" GroupName="BacktestProfile" IsChecked="True" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Moedas -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Moedas:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>

            <RadioButton x:Name="rbManual" Content="Manual:" GroupName="SymbolMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtManualSymbols" Width="280" Text="BTCUSDT,ETHUSDT,SOLUSDT" Margin="0,0,6,0" VerticalAlignment="Center" TextChanged="TxtManualSymbols_TextChanged"/>
            <TextBlock x:Name="txtManualSymbolsCount" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,20,0"/>

            <RadioButton x:Name="rbAuto" Content="Top automático:" GroupName="SymbolMode" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtTopN" Width="50" Text="20" VerticalAlignment="Center"/>
            <TextBlock Text="moedas por volume atual" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray" FontSize="11"/>
            <Button Content="Congelar lista em Manual" Height="22" Padding="8,0" Margin="12,0,20,0" Click="BtnFreezeSymbolList_Click"/>

            <TextBlock Text="Histórico mín. (anos):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
            <TextBox x:Name="txtHistoryYears" Width="35" Text="5" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button Content="Congelar com Histórico Garantido" Height="22" Padding="8,0" Margin="0,0,20,0" Click="BtnFreezeWithFullHistory_Click"/>
            <Button Content="Histórico de Testes" Height="22" Padding="8,0" Click="BtnBacktestHistory_Click"/>
        </StackPanel>

        <!-- Limiares (editáveis só para este backtest, não afeta o ScannerSettings real) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Limiares deste teste:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>

            <TextBlock Text="Score mín.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMinScore" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Dist. Resist. mín. Swing %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMinResistDistance" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Dist. Resist. mín. ATR %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMinResistDistanceAtr" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Volume Spike mín.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMinVolumeSpike" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Risk/Reward mín.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMinRiskReward" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Stop mín. %:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMinStopDistance" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Risk/Reward máx.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMaxRiskReward" Width="45" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Timeout (h, vazio=padrão):" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtEvaluationHoursOverride" Width="55" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Caminho de entrada alternativo (desativado por padrão) -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Caminho alternativo:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <CheckBox x:Name="chkPullbackBounce" Content="Caminho A — Repique de Recuo" VerticalAlignment="Center" Margin="0,0,24,0"/>

            <TextBlock Text="Cálculo de Risco:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <RadioButton x:Name="rbRiskSwing" Content="Swing (atual)" GroupName="RiskMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton x:Name="rbRiskAtr" Content="ATR (novo)" GroupName="RiskMode" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton x:Name="rbRiskSwingBuffer" Content="Swing + Buffer ATR (novo)" GroupName="RiskMode" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Teste definitivo: configuração padrão do app, múltiplos períodos não sobrepostos -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Teste Definitivo:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>

            <TextBlock Text="Anos por período:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtPeriodYears" Width="40" Text="1" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <TextBlock Text="Quantidade de períodos:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtPeriodCount" Width="40" Text="4" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <Button x:Name="btnComparePeriods" Content="Rodar Teste Definitivo (Padrão do App)" Height="24" Padding="8,0" Click="BtnComparePeriods_Click"/>
            <Button x:Name="btnCompareRiskMode" Content="Comparar Swing vs ATR (Definitivo)" Height="24" Padding="8,0" Margin="0,0,8,0" Click="BtnCompareRiskMode_Click"/>
            <Button x:Name="btnCompareAtrDistance" Content="Comparar Dist. Resist. (ATR)" Height="24" Padding="8,0" Margin="0,0,8,0" Click="BtnCompareAtrDistanceScenarios_Click"/>
            <Button x:Name="btnCompareTimeout" Content="Comparar Cenários (Timeout)" Height="24" Padding="8,0" Click="BtnCompareTimeoutScenarios_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="5"
               Margin="0,26,0,0"
               FontSize="10"
               FontStyle="Italic"
               Foreground="Gray"
               Text="Ignora os limiares/caminhos configurados acima — usa sempre a configuração padrão exata do ScannerSettings (a mesma do app ao vivo)."/>

        <!-- Ações -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnRun" Content="Rodar Backtest" Width="130" Height="26" Click="BtnRun_Click"/>
            <Button x:Name="btnCompare" Content="Comparar Cenários (RR)" Width="160" Height="26" Margin="8,0,0,0" Click="BtnCompareScenarios_Click"/>
            <Button x:Name="btnCompareStop" Content="Comparar Cenários (Stop)" Width="170" Height="26" Margin="8,0,0,0" Click="BtnCompareStopScenarios_Click"/>
            <Button x:Name="btnCompareMaxRR" Content="Comparar Cenários (Teto RR)" Width="180" Height="26" Margin="8,0,0,0" Click="BtnCompareMaxRRScenarios_Click"/>
            <Button x:Name="btnCompareNewPaths" Content="Comparar Cenários (Caminhos)" Width="190" Height="26" Margin="8,0,0,0" Click="BtnCompareNewPathsScenarios_Click"/>
            <Button x:Name="btnCancel" Content="Cancelar" Width="90" Height="26" Margin="8,0,0,0" IsEnabled="False" Click="BtnCancel_Click"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <ProgressBar x:Name="pbProgress"
                 Grid.Row="6"
                 Height="6"
                 Margin="0,32,0,0"
                 VerticalAlignment="Top"
                 Minimum="0"
                 Maximum="100"
                 Visibility="Collapsed"/>

        <!-- Resultados -->
        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="WhiteSmoke" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,10" MaxHeight="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtSummaryResult" FontWeight="Bold" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <DataGrid x:Name="dgComparison"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Visibility="Collapsed"
                  MaxHeight="180"
                  Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cenário" Binding="{Binding Label}" Width="140"/>
                    <DataGridTextColumn Header="Operações" Binding="{Binding TotalTrades}" Width="90"/>
                    <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="90"/>
                    <DataGridTextColumn Header="Retorno %" Binding="{Binding TotalReturnPercent, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Drawdown %" Binding="{Binding MaxDrawdownPercent, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="Profit Factor" Binding="{Binding ProfitFactor, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="RR Médio" Binding="{Binding AvgRiskRewardAtEntry, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Win Rate Equilíbrio %" Binding="{Binding BreakEvenWinRate, StringFormat=F1}" Width="140"/>

                    <DataGridTextColumn Header="Edge (pontos %)" Binding="{Binding Edge, StringFormat=F1}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Edge, Converter={StaticResource EdgeColorConverter}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Background="White" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Curva de Retorno Acumulado (por ordem cronológica de saída)"
                           FontWeight="Bold" FontSize="11" Margin="6,4,0,0"/>
                    <Canvas x:Name="cnvEquityCurve" Height="170" Margin="4" SizeChanged="CnvEquityCurve_SizeChanged"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="dgTrades" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" Width="90"/>
                    <DataGridTextColumn Header="Entrada" Binding="{Binding EntryTime, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Preço Entrada" Binding="{Binding EntryPrice}" Width="100"/>
                    <DataGridTextColumn Header="Saída" Binding="{Binding ExitTime, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Preço Saída" Binding="{Binding ExitPrice}" Width="100"/>
                    <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="Motivo" Binding="{Binding ExitReason}" Width="80"/>
                    <DataGridTextColumn Header="Sinal" Binding="{Binding Signal}" Width="90"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="Res % (entrada)" Binding="{Binding ResistanceDistancePercent, StringFormat=F1}" Width="110"/>
                    <DataGridTextColumn Header="Sup % (entrada)" Binding="{Binding SupportDistancePercent, StringFormat=F1}" Width="110"/>
                    <DataGridTextColumn Header="RR (entrada)" Binding="{Binding RiskRewardAtEntry, StringFormat=F2}" Width="90"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExitReason}" Value="TP">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExitReason}" Value="SL">
                                <Setter Property="Background" Value="LightSalmon"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExitReason}" Value="TIMEOUT">
                                <Setter Property="Background" Value="LightGray"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>

    </Grid>
</Window>
