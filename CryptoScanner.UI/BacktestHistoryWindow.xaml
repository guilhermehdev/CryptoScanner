<Window x:Class="CryptoScanner.UI.BacktestHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Testes de Backtest" Height="600" Width="1300"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Todo teste rodado no Backtest Completo é salvo automaticamente aqui — configurações idênticas não duplicam. Clique nos cabeçalhos das colunas para ordenar. Segure Ctrl/Shift para selecionar várias linhas."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Exportar TXT (selecionados, ou todos se nenhum selecionado)" Padding="8,4" Click="BtnExportTxt_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgResults" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" FontSize="10" Padding="4,1" Foreground="DarkRed" Click="BtnDeleteResult_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Salvo em" Binding="{Binding SavedAt, StringFormat=dd/MM/yy HH:mm}" Width="110"/>
                <DataGridTextColumn Header="Rótulo" Binding="{Binding Label}" Width="160"/>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="70"/>
                <DataGridTextColumn Header="Modo Risco" Binding="{Binding RiskMode}" Width="130"/>
                <DataGridTextColumn Header="Início" Binding="{Binding StartDate, StringFormat=dd/MM/yy}" Width="70"/>
                <DataGridTextColumn Header="Fim" Binding="{Binding EndDate, StringFormat=dd/MM/yy}" Width="70"/>
                <DataGridTextColumn Header="Moedas" Binding="{Binding SymbolCount}" Width="60"/>
                <DataGridTextColumn Header="Score min." Binding="{Binding MinScore, StringFormat=F0}" Width="70"/>
                <DataGridTextColumn Header="RR min." Binding="{Binding MinRiskReward, StringFormat=F1}" Width="60"/>
                <DataGridTextColumn Header="RR max." Binding="{Binding MaxRiskReward, StringFormat=F0}" Width="60"/>
                <DataGridCheckBoxColumn Header="Bollinger" Binding="{Binding EnableBollingerScoring}" Width="65"/>
                <DataGridCheckBoxColumn Header="Vol. Fase B" Binding="{Binding EnableVolatilityScoringPhaseB}" Width="75"/>
                <DataGridTextColumn Header="Timeout(h)" Binding="{Binding EvaluationHoursOverride}" Width="80"/>
                <DataGridTextColumn Header="Operações" Binding="{Binding TotalTrades}" Width="80"/>
                <DataGridTextColumn Header="Win Rate %" Binding="{Binding WinRate, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="Retorno %" Binding="{Binding TotalReturnPercent, StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="Drawdown %" Binding="{Binding MaxDrawdownPercent, StringFormat=F2}" Width="90"/>
                <DataGridTextColumn Header="Profit Factor" Binding="{Binding ProfitFactor, StringFormat=F2}" Width="90"/>
                <DataGridTextColumn Header="RR Médio" Binding="{Binding AvgRiskRewardAtEntry, StringFormat=F2}" Width="80"/>
                <DataGridTextColumn Header="Edge" Binding="{Binding Edge, StringFormat=F1}" Width="70"/>
                <DataGridTextColumn Header="Moedas (lista)" Binding="{Binding Symbols}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
