<Window x:Class="CryptoScanner.UI.SimulateTradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simular Trade" Height="400" Width="380"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15">
        <TextBlock x:Name="txtSymbolHeader" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <TextBlock Text="Preço de Entrada (atualizado ao salvar):" FontSize="11" Foreground="Gray"/>
        <TextBox x:Name="txtEntryPrice" IsReadOnly="True" Margin="0,2,0,10"/>

        <TextBlock Text="Take Profit:" FontSize="11" Foreground="Gray"/>
        <TextBox x:Name="txtTakeProfit" Margin="0,2,0,10"/>

        <TextBlock Text="Stop Loss:" FontSize="11" Foreground="Gray"/>
        <TextBox x:Name="txtStopLoss" Margin="0,2,0,10"/>

        <TextBlock Text="Observação (opcional):" FontSize="11" Foreground="Gray"/>
        <TextBox x:Name="txtNote" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2,0,15"/>

        <TextBlock Text="O trade fica em aberto até bater TP, SL, ou você fechar manualmente — sem prazo automático." 
                   FontSize="10" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salvar" Width="80" Padding="0,5" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Cancelar" Width="80" Padding="0,5" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
