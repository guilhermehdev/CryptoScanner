<Window x:Class="CryptoScanner.UI.AltseasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altseason Monitor" Height="620" Width="980"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Background="#2A2A2A" Padding="18,10" CornerRadius="5" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="ALTSEASON SCORE" FontSize="11" Foreground="Gray"/><TextBlock x:Name="txtScore" Text="—" FontSize="30" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="#2A2A2A" Padding="18,10" CornerRadius="5" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="ESTADO" FontSize="11" Foreground="Gray"/><TextBlock x:Name="txtState" Text="—" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="#2A2A2A" Padding="18,10" CornerRadius="5">
                <StackPanel><TextBlock Text="AÇÃO" FontSize="11" Foreground="Gray"/><TextBlock x:Name="txtAction" Text="—" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="txtMarket" Margin="0,12,0,10" Foreground="LightGray"/>
        <DataGrid Grid.Row="2" x:Name="dgIndicators" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Indicador" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="Peso" Binding="{Binding Weight, StringFormat=P0}" Width="100"/>
                <DataGridTextColumn Header="Contribuição" Binding="{Binding Contribution, StringFormat=F1}" Width="120"/>
                <DataGridTextColumn Header="Sinal" Binding="{Binding Signal}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="txtUpdated" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,12,0"/>
            <Button x:Name="btnRefresh" Content="Atualizar" Padding="14,5" Click="Refresh_Click"/>
        </StackPanel>
    </Grid>
</Window>
