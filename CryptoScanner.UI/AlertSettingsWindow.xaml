<Window x:Class="CryptoScanner.UI.AlertSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Alertas" Height="620" Width="520"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
        <StackPanel>

            <TextBlock Text="Alertas de Novo Sinal" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="Você é avisado sempre que o scanner registrar um sinal elegível de verdade (não a cada scan)." 
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <!-- Desktop -->
            <GroupBox Header="Notificação de Desktop (Push)" Padding="10" Margin="0,0,0,12">
                <CheckBox x:Name="chkDesktop" Content="Mostrar balão de notificação na bandeja do sistema"/>
            </GroupBox>

            <!-- Telegram -->
            <GroupBox Header="Telegram" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="chkTelegram" Content="Ativar" Margin="0,0,0,8"/>

                    <TextBlock Text="Bot Token:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtTelegramToken" Margin="0,2,0,8"/>

                    <TextBlock Text="Chat ID:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtTelegramChatId" Margin="0,2,0,8"/>

                    <TextBlock Text="Crie um bot com @BotFather e pegue o Chat ID conversando com @userinfobot." 
                               FontSize="10" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button x:Name="btnTestTelegram" Content="Testar Telegram" HorizontalAlignment="Left" Padding="8,3" Click="BtnTestTelegram_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Discord -->
            <GroupBox Header="Discord" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="chkDiscord" Content="Ativar" Margin="0,0,0,8"/>

                    <TextBlock Text="Webhook URL:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtDiscordWebhook" Margin="0,2,0,8"/>

                    <TextBlock Text="Configurações do Canal → Integrações → Webhooks → Novo Webhook, no Discord." 
                               FontSize="10" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button x:Name="btnTestDiscord" Content="Testar Discord" HorizontalAlignment="Left" Padding="8,3" Click="BtnTestDiscord_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Email -->
            <GroupBox Header="Email" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="chkEmail" Content="Ativar" Margin="0,0,0,8"/>

                    <TextBlock Text="Servidor SMTP:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtEmailHost" Text="smtp.gmail.com" Margin="0,2,0,8"/>

                    <TextBlock Text="Porta:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtEmailPort" Text="587" Margin="0,2,0,8"/>

                    <TextBlock Text="Usuário (seu email):" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtEmailUsername" Margin="0,2,0,8"/>

                    <TextBlock Text="Senha (recomendado: senha de app, não a principal):" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtEmailPassword" Margin="0,2,0,8"/>

                    <TextBlock Text="Remetente:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtEmailFrom" Margin="0,2,0,8"/>

                    <TextBlock Text="Destinatário (pra onde os alertas vão):" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtEmailTo" Margin="0,2,0,8"/>

                    <CheckBox x:Name="chkEmailSsl" Content="Usar SSL/TLS" IsChecked="True" Margin="0,0,0,8"/>

                    <Button x:Name="btnTestEmail" Content="Testar Email" HorizontalAlignment="Left" Padding="8,3" Click="BtnTestEmail_Click"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="btnSave" Content="Salvar" Width="90" Padding="0,5" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button x:Name="btnClose" Content="Fechar" Width="90" Padding="0,5" Click="BtnClose_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
