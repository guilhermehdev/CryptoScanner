<Window x:Class="CryptoScanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        mc:Ignorable="d"
        Title="ScannerCripto" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White">
    <Window.Resources>
        <local:PnLColorConverter x:Key="PnLColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush x:Key="DarkPanelBackground" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="DarkAltRowBackground" Color="#252525"/>
        <SolidColorBrush x:Key="DarkBorder" Color="#444444"/>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="#1E1E1E"/><Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#404040"/><Setter Property="Foreground" Value="Black"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="White"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#282828"/><Setter Property="Foreground" Value="#00FFFF"/><Setter Property="FontSize" Value="14"/></Style>
        <Style x:Key="LightTradeGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#686868"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="3,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="borderRegime" Background="Gray" CornerRadius="4" Padding="12,6" Margin="0,0,28,0" VerticalAlignment="Center"><StackPanel><TextBlock Text="REGIME DE MERCADO" FontSize="9" Foreground="White" Opacity="0.85"/><TextBlock x:Name="txtDashboardRegime" Text="—" FontWeight="Bold" FontSize="14" Foreground="White"/></StackPanel></Border>
                <StackPanel Margin="0,0,28,0" VerticalAlignment="Center"><TextBlock Text="BTC" FontSize="9" Foreground="Gray"/><TextBlock x:Name="txtDashboardBtcPrice" Text="—" FontWeight="Bold" FontSize="14" Foreground="Black"/></StackPanel>
                <StackPanel Margin="0,0,28,0" VerticalAlignment="Center"><TextBlock Text="DOMINÂNCIA BTC" FontSize="9" Foreground="Gray"/><TextBlock x:Name="txtDashboardBtcDominance" Text="—" FontWeight="Bold" FontSize="14" Foreground="Black"/></StackPanel>
                <StackPanel Margin="0,0,28,0" VerticalAlignment="Center"><TextBlock Text="SINAIS ELEGÍVEIS AGORA" FontSize="9" Foreground="Gray"/><TextBlock x:Name="txtDashboardEligible" Text="—" FontWeight="Bold" FontSize="14" Foreground="Black"/></StackPanel>
                <StackPanel Margin="0,0,28,0" VerticalAlignment="Center"><TextBlock Text="TOP CANDIDATOS" FontSize="9" Foreground="Gray"/><TextBlock x:Name="txtDashboardTopCandidates" Text="—" FontWeight="Bold" FontSize="14" Foreground="Black"/></StackPanel>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="DIÁRIO DE TRADES SIMULADOS" FontSize="9" Foreground="Gray"/><TextBlock x:Name="txtDashboardSimulated" Text="—" FontWeight="Bold" FontSize="14" Foreground="Black"/></StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="10,6">
            <TextBlock x:Name="txtScanSummary" Text="Aguardando a primeira atualização…" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <DockPanel Margin="0,5,0,5">
                <Button DockPanel.Dock="Right" Content="Ver motivos" Padding="10,3" Margin="10,0,0,0" Click="BtnScanReasons_Click"/>
                <TextBlock x:Name="txtDiagnostics" Text="Os motivos de bloqueio aparecerão após a análise." Foreground="#D0D0D0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,5">
                <TextBlock Text="Histórico de sinais · " Foreground="#B8B8B8"/>
                <TextBlock x:Name="txtWinRate" Text="Sem resultados avaliados"/>
                <TextBlock x:Name="txtAvgReturn" Margin="12,0,0,0"/>
                <TextBlock x:Name="txtPending" Margin="12,0,0,0"/>
                <TextBlock x:Name="txtEvaluated" Margin="12,0,0,0"/>
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="rbIntraday" Content="Intraday (1h / 24h)" GroupName="Profile" Margin="0,3,12,3" VerticalAlignment="Center" Checked="ProfileChanged"/>
                <RadioButton x:Name="rbSwing" Content="Swing (4h / 10 dias)" GroupName="Profile" IsChecked="True" Margin="0,3,16,3" VerticalAlignment="Center" Checked="ProfileChanged"/>
                <TextBlock Text="Lado:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="rbScanBoth" Content="Ambos" GroupName="ScanDirection" IsChecked="True" Margin="0,3,8,3" VerticalAlignment="Center" Checked="ScanDirectionChanged"/>
                <RadioButton x:Name="rbScanLong" Content="Compra" GroupName="ScanDirection" Margin="0,3,8,3" VerticalAlignment="Center" Checked="ScanDirectionChanged"/>
                <RadioButton x:Name="rbScanShort" Content="Venda" GroupName="ScanDirection" Margin="0,3,16,3" VerticalAlignment="Center" Checked="ScanDirectionChanged"/>
                <CheckBox x:Name="chkShortExperimental" Content="Short: rompimento" IsChecked="True" Margin="0,3,16,3" VerticalAlignment="Center" Checked="ShortExperimentalChanged" Unchecked="ShortExperimentalChanged" ToolTip="Modo experimental operacional: somente rompimentos Short no Intraday, risco local, R/R mínimo 1,8 e alvo mínimo 8%. O Long permanece apenas em observação."/>
                <CheckBox x:Name="chkFavoritesOnly" Content="★ Só favoritos" Margin="0,3,16,3" VerticalAlignment="Center" Checked="ChkFavoritesOnly_Changed" Unchecked="ChkFavoritesOnly_Changed"/>
                <TextBlock Text="Ativo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtSearchSymbol" Width="100" Margin="0,3,6,3" VerticalAlignment="Center" KeyDown="TxtSearchSymbol_KeyDown"/>
                <Button x:Name="btnSearch" Content="Buscar" Padding="8,2" Margin="0,3,12,3" Click="BtnSearch_Click"/>
                <Button x:Name="btAtualizar" Content="Atualizar" Padding="8,2" Margin="0,3,8,3" Click="btAtualizar_Click" Background="DarkSeaGreen"/>
                <TextBlock Text="Auto (min):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtAutoScanInterval" Width="32" Margin="0,3,12,3" VerticalAlignment="Center" TextAlignment="Center" LostFocus="TxtAutoScanInterval_LostFocus" ToolTip="Intervalo em minutos. Saia do campo para salvar."/><CheckBox x:Name="chkAutoLlmTop30" Content="LLM auto top 30" IsChecked="True" Margin="0,3,16,3" VerticalAlignment="Center" ToolTip="Analisa automaticamente os 30 melhores ativos de cada perfil após a varredura."/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Análise" Click="BtnAnalytics_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Backtest" Click="BtnFullBacktest_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Histórico" Click="BtnBacktestHistory_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Alertas" Click="BtnAlertSettings_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Análise da pressão" Click="BtnPressureAnalysis_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Laboratório" Click="BtnStrategyLab_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Histórico LLM" Click="BtnLlmHistory_Click" Padding="8,2" Margin="0,3,6,0"/>
                <Button Content="Analisar com LLM" ToolTip="Analisa a moeda selecionada usando os dados estruturados do scanner" Click="BtnAnalyzeWithLlm_Click" Padding="8,2" Margin="0,3,6,0"/>
            </WrapPanel>
            <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" Padding="4" Margin="0,3,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copiar análise" ToolTip="Copiar todo o retorno da LLM" Click="BtnCopyLlmOpinion_Click" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtLlmOpinion" Text="LLM consultiva: selecione uma moeda e use 'Analisar com LLM'." IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#D0D0D0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="55"/>
                </DockPanel>
            </Border>
        </StackPanel>
        <TabControl Grid.Row="2" SelectedIndex="0">
            <TabItem Header="Scanner">
                <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="5,2" FontSize="11" ToolTip="Verde: todos os filtros atendidos. Nos demais, score ≥70 azul; 55–69,99 amarelo; 40–54,99 cinza; abaixo de 40 preto. Armadilha de alta tem prioridade em laranja. As cores não representam probabilidade de lucro.">
                <Run Foreground="#75D39B" Text="● Verde: elegível  "/><Run Foreground="#79B6EB" Text="● Azul: candidato  "/><Run Foreground="#E6C96A" Text="● Amarelo: observar  "/><Run Foreground="#BBBBBB" Text="● Cinza: baixa prioridade  "/><Run Foreground="#BBBBBB" Text="■ Preto: ignorar  "/><Run Foreground="#F5A34E" Text="● Laranja: armadilha"/>
            </TextBlock>
        <DataGrid x:Name="dgRanking" FontSize="12" HeadersVisibility="Column" AutoGenerateColumns="False" IsReadOnly="True" MouseLeftButtonUp="DgRanking_MouseLeftButtonUp" MouseRightButtonUp="DgRanking_MouseRightButtonUp">
            <DataGrid.Resources><Style x:Key="CompactRankingText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></DataGrid.Resources><DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#111111"/>
                    <Setter Property="Foreground" Value="#F5F5F5"/>
                    <EventSetter Event="MouseLeave" Handler="DgRankingRow_MouseLeave"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Signal}" Value="MONITORAR"><Setter Property="Background" Value="#383838"/></DataTrigger>
                        <DataTrigger Binding="{Binding Signal}" Value="COMPRA"><Setter Property="Background" Value="#E6C96A"/><Setter Property="Foreground" Value="#171717"/></DataTrigger>
                        <DataTrigger Binding="{Binding Signal}" Value="COMPRA+"><Setter Property="Background" Value="#244C70"/><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                        <DataTrigger Binding="{Binding Signal}" Value="VENDA"><Setter Property="Background" Value="#E58B8B"/><Setter Property="Foreground" Value="#171717"/></DataTrigger>
                        <DataTrigger Binding="{Binding Signal}" Value="VENDA+"><Setter Property="Background" Value="#7A2636"/><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsEligible}" Value="True"><Setter Property="Background" Value="#24613D"/><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsBullTrap}" Value="True"><Setter Property="Background" Value="#D98125"/><Setter Property="Foreground" Value="#171717"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                            <Setter Property="BorderThickness" Value="0,1,0,1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="24"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Favorito"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsFavorite, Mode=OneWay}" Click="ChkFavorite_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridCheckBoxColumn Binding="{Binding IsEligible}" Header="Eleg." Width="38"><DataGridCheckBoxColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Elegível para entrada"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridCheckBoxColumn.HeaderStyle></DataGridCheckBoxColumn>
                <DataGridTemplateColumn Header="" Width="42"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Abrir simulação"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Sim." ToolTip="Abrir trade simulado" FontSize="11" Padding="2,1" Foreground="#00FFFF" Click="BtnSimulateTrade_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Symbol}" ElementStyle="{StaticResource CompactRankingText}" Header="Ativo" Width="85"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Moeda"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding DirectionText}" ElementStyle="{StaticResource CompactRankingText}" Header="Lado" Width="50"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Direção do sinal: Compra ou Venda"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding CloseFormatted}" ElementStyle="{StaticResource CompactRankingText}" Header="P. anál." Width="76"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Preço do candle fechado usado nos cálculos"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding LivePriceFormatted}" ElementStyle="{StaticResource CompactRankingText}" Header="Atual" Width="76"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Cotação mais recente"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Score, StringFormat=F2}" ElementStyle="{StaticResource CompactRankingText}" Header="Score" Width="44"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Score do ranking; não é probabilidade de acerto"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding BuyingPressureScore, StringFormat=F0, TargetNullValue=—}" Header="P. comp." Width="53"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Pressão compradora"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CompactRankingText}">
                            <Setter Property="ToolTip" Value="{Binding BuyingPressureDetails}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding VariationText}" ElementStyle="{StaticResource CompactRankingText}" Header="Δ Score" Width="58"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Variação do score"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Resistance, StringFormat=0.########}" ElementStyle="{StaticResource CompactRankingText}" Header="Alvo" Width="76"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Resistência / segundo alvo (TP2)"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ResistanceDistance, StringFormat=F1}" ElementStyle="{StaticResource CompactRankingText}" Header="Alvo%" Width="43"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Distância do preço de análise ao alvo"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding SupportDistance, StringFormat=F1}" ElementStyle="{StaticResource CompactRankingText}" Header="Stop%" Width="43"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Distância do preço de análise ao stop"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding RiskReward, StringFormat=F2}" ElementStyle="{StaticResource CompactRankingText}" Header="R/R" Width="38"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Distância ao alvo dividida pela distância ao stop"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding VolumeSpike, StringFormat=F2}" ElementStyle="{StaticResource CompactRankingText}" Header="Vol×" Width="40"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Volume do candle fechado dividido pela média dos 19 anteriores"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding CompactContext}" ElementStyle="{StaticResource CompactRankingText}" Header="Ctx." Width="54"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Contexto: rompimento clássico, curto prazo ou força relativa"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding TrendDirection}" ElementStyle="{StaticResource CompactRankingText}" Header="Tend." Width="45"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Direção da tendência"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding DisplaySignal}" ElementStyle="{StaticResource CompactRankingText}" Header="Sinal" Width="74"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Sinal após os filtros de elegibilidade"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridCheckBoxColumn Binding="{Binding IsConsolidating}" Header="Cons." Width="40"><DataGridCheckBoxColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Consolidação; obrigatória apenas em BULL"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridCheckBoxColumn.HeaderStyle></DataGridCheckBoxColumn>
                <DataGridTextColumn Binding="{Binding CompactRelativeStrength}" ElementStyle="{StaticResource CompactRankingText}" Header="F. rel." Width="59"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Desempenho relativo ao BTC"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridCheckBoxColumn Binding="{Binding HasExhaustion}" Header="Exaust." Width="47"><DataGridCheckBoxColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Exaustão de volume"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridCheckBoxColumn.HeaderStyle></DataGridCheckBoxColumn>
                <DataGridTextColumn Binding="{Binding PatternName}" ElementStyle="{StaticResource CompactRankingText}" Header="Padrão" Width="73"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Padrão do candle"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding SmartMoneyLabel}" ElementStyle="{StaticResource CompactRankingText}" Header="SM" Width="65"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Smart Money"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="2,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Diário de Trades Simulados">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="txtSimulatedSummary" Grid.Row="0" Margin="4" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,4"><Button Content="Atualizar Diário" Click="BtnRefreshSimulatedTrades_Click" Padding="8,3"/><Button x:Name="btnToggleClosedTrades" Content="Mostrar Concluídos" Click="BtnToggleClosedTrades_Click" Padding="8,3" Margin="8,0,0,0"/></StackPanel>
                    <DataGrid x:Name="dgSimulatedTrades" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" RowEditEnding="DgSimulatedTrades_RowEditEnding" PreviewMouseRightButtonDown="DgSimulatedTrades_PreviewMouseRightButtonDown" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#686868" VerticalGridLinesBrush="#686868" CellStyle="{StaticResource LightTradeGridCell}">
                        <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Copiar linha" Click="BtnCopySimulatedTradeRow_Click"/></ContextMenu></DataGrid.ContextMenu>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding ExitReason}" Value="TP"><Setter Property="Background" Value="LightGreen"/></DataTrigger><DataTrigger Binding="{Binding ExitReason}" Value="SL"><Setter Property="Background" Value="LightSalmon"/></DataTrigger><DataTrigger Binding="{Binding ExitReason}" Value="Manual"><Setter Property="Background" Value="LightGray"/></DataTrigger><DataTrigger Binding="{Binding Closed}" Value="False"><Setter Property="Background" Value="LightYellow"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="30"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="X" FontSize="11" Padding="4,1" Foreground="#00FFFF" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}" Click="BtnCloseSimulatedTradeRow_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Lado" Binding="{Binding Direction}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding EntryTime, StringFormat=dd/MM HH:mm}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding EntryPrice, StringFormat=0.########}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Pressão na entrada" Binding="{Binding BuyingPressureAtEntry, StringFormat=F0, TargetNullValue=—}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Atual" Binding="{Binding CurrentPrice, StringFormat=0.########}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Progresso" Binding="{Binding PartialExitProgressText}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding StopLoss, Mode=TwoWay}" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding ScoreAtEntry, StringFormat=F2}" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Aberto?" Binding="{Binding IsOpen, Mode=OneWay}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="P/L Atual %" Binding="{Binding UnrealizedPnLPercent, StringFormat='+0.00;-0.00;0.00'}" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding UnrealizedPnLPercent, Converter={StaticResource PnLColorConverter}}"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Saída" Binding="{Binding ExitTime, StringFormat=dd/MM HH:mm}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding ExitReason}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Observação" Binding="{Binding Note, Mode=TwoWay}" IsReadOnly="False" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Histórico de Sinais">
                <DataGrid x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#686868" VerticalGridLinesBrush="#686868" CellStyle="{StaticResource LightTradeGridCell}" MouseRightButtonUp="DgHistory_MouseRightButtonUp">
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding ExitReason}" Value="TP"><Setter Property="Background" Value="LightGreen"/></DataTrigger><DataTrigger Binding="{Binding ExitReason}" Value="SL"><Setter Property="Background" Value="LightSalmon"/></DataTrigger><DataTrigger Binding="{Binding ExitReason}" Value="TIMEOUT"><Setter Property="Background" Value="LightGray"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                    <DataGrid.Columns><DataGridTextColumn Header="Data" Width="100" Binding="{Binding Timestamp, StringFormat=dd/MM HH:mm}"/><DataGridTextColumn Header="Moeda" Width="105" Binding="{Binding Symbol}"/><DataGridTextColumn Header="Lado" Width="65" Binding="{Binding Direction}"/><DataGridTextColumn Header="Entrada" Width="110" Binding="{Binding Price}"/><DataGridTextColumn Header="Atual" Width="110" Binding="{Binding DisplayedPriceFormatted}"/><DataGridTextColumn Header="L/P" Width="80" Binding="{Binding DisplayedPnLPercentFormatted}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding DisplayedPnLPercent, Converter={StaticResource PnLColorConverter}}"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Score" Width="80" Binding="{Binding FinalScore}"/><DataGridTextColumn Header="Resultado %" Width="110" Binding="{Binding OutcomePercent, StringFormat=F2}"/><DataGridTextColumn Header="Motivo" Width="*" Binding="{Binding ExitReason}"/><DataGridCheckBoxColumn Header="Avaliado" Width="85" Binding="{Binding Evaluated}"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Popup x:Name="popupBreakdown" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="#2A2A2A" BorderBrush="{StaticResource DarkBorder}" BorderThickness="1" Padding="10" MaxWidth="400" TextElement.Foreground="White">
                <StackPanel>
                    <TextBlock Text="Score Breakdown" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding QualityAnalysis}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Alvos (TP1|TP2|TP3): " FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding PartialExitTargetsText}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                    <UniformGrid Columns="4" Rows="2">
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Trend" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding TrendScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Structure" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding StructureScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Volume" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding VolumeScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Candle" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding CandleScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Setup" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding SetupScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Momentum" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding MomentumScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Volatility" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding VolatilityScore}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Trend Strength" FontSize="12" Foreground="Gray"/><TextBlock Text="{Binding TrendStrengthScore}" FontWeight="Bold"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
