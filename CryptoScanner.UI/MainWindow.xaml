<Window x:Class="CryptoScanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        mc:Ignorable="d"
        Title="ScannerCripto" Height="600" Width="1250"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="10">

            <TextBlock x:Name="txtWinRate"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtAvgReturn"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtPending"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtEvaluated"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

        </StackPanel>

        <TextBlock x:Name="txtDiagnostics"
               Grid.Row="0"
               Margin="10,32,10,0"
               FontSize="11"
               Foreground="Gray"
               TextWrapping="Wrap"/>

        <TextBlock Grid.Row="0"
               Margin="10,50,10,0"
               FontSize="10"
               FontStyle="Italic"
               Foreground="Gray"
               Text="*Consol.: exigido apenas quando o regime de mercado é BULL. Em BEAR/SIDEWAYS (modo defensivo), esse critério é apenas informativo."/>

        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="10,68,0,0"
                VerticalAlignment="Top">

            <TextBlock Text="Perfil:"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Margin="0,0,8,0"/>

            <RadioButton x:Name="rbIntraday"
                     Content="Intraday (1h / 24h)"
                     GroupName="Profile"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     Checked="ProfileChanged"/>

            <RadioButton x:Name="rbSwing"
                     Content="Swing (4h / 10 dias)"
                     GroupName="Profile"
                     IsChecked="True"
                     VerticalAlignment="Center"
                     Checked="ProfileChanged"/>

        </StackPanel>

        <DataGrid x:Name="dgRanking"
              Grid.Row="1"
              AutoGenerateColumns="False"
              IsReadOnly="True">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">

                    <EventSetter Event="MouseLeftButtonUp" Handler="DgRankingRow_Click"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="COMPRA+">
                            <Setter Property="Background"
                                Value="LightGreen"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="COMPRA">
                            <Setter Property="Background"
                                Value="LightBlue"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="MONITORAR">
                            <Setter Property="Background"
                                Value="Khaki"/>
                        </DataTrigger>

                        <!-- Alerta de risco: sobrepõe a cor do sinal quando há Bull Trap detectado -->
                        <DataTrigger Binding="{Binding IsBullTrap}"
                                 Value="True">
                            <Setter Property="Background"
                                Value="Orange"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" />
                <DataGridTextColumn Header="Preço" Binding="{Binding CloseFormatted}" />
                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F2}" />
                <DataGridTextColumn Header="Variação" Binding="{Binding VariationText}" />
                <DataGridTextColumn Header="Elite" Binding="{Binding EliteText}" />
                <DataGridTextColumn Header="Resistência" Binding="{Binding Resistance}" />
                <DataGridTextColumn Header="Via Rompimento" Binding="{Binding BreakoutSource}" />
                <DataGridTextColumn Header="Risk/Reward" Binding="{Binding RiskReward, StringFormat=F2}" />
                <DataGridTextColumn Header="Trend" Binding="{Binding TrendDirection}" />
                <DataGridTextColumn Header="Sinal" Binding="{Binding Signal}" />

                <DataGridCheckBoxColumn Header="Consol.*" Binding="{Binding IsConsolidating}">
                    <DataGridCheckBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConsolidationRelevant}" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Setter Property="ToolTip" Value="Não exigido como critério no regime de mercado atual (modo defensivo)."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn Header="Volume Spike" Binding="{Binding VolumeSpike, StringFormat=F2}" />
                <DataGridTextColumn Header="Res %" Binding="{Binding ResistanceDistance, StringFormat=F1}" />
                <DataGridTextColumn Header="Sup %" Binding="{Binding SupportDistance, StringFormat=F1}" />
                <DataGridTextColumn Header="Força Rel." Binding="{Binding RelativeStrengthText}" />
                <DataGridCheckBoxColumn Header="Exaustão" Binding="{Binding HasExhaustion}" />
                <DataGridTextColumn Header="Padrão" Binding="{Binding PatternName}" />
                <DataGridTextColumn Header="Smart Money" Binding="{Binding SmartMoneyLabel}" />


            </DataGrid.Columns>

        </DataGrid>

        <DataGrid x:Name="dgHistory"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding ExitReason}"
                                 Value="TP">
                            <Setter Property="Background"
                                Value="LightGreen"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ExitReason}"
                                 Value="SL">
                            <Setter Property="Background"
                                Value="LightSalmon"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ExitReason}"
                                 Value="TIMEOUT">
                            <Setter Property="Background"
                                Value="LightGray"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat=dd/MM HH:mm}" />
                <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" />
                <DataGridTextColumn Header="Entrada" Binding="{Binding Price}" />
                <DataGridTextColumn Header="Score" Binding="{Binding FinalScore}" />
                <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" />
                <DataGridTextColumn Header="Motivo" Binding="{Binding ExitReason}" />
                <DataGridCheckBoxColumn Header="Avaliado" Binding="{Binding Evaluated}" />

            </DataGrid.Columns>

        </DataGrid>
        <Button Content="Backtest BTC" Click="BtnBacktest_Click" HorizontalAlignment="Left" Height="19" Margin="696,7,0,0" VerticalAlignment="Top" Width="78"/>
        <Button x:Name="btAtualizar" Content="Atualizar" HorizontalAlignment="Left" Height="19" Margin="614,7,0,0" VerticalAlignment="Top" Width="77" RenderTransformOrigin="0.509,0.601" Click="btAtualizar_Click"/>
        <Button Content="Análise" Click="BtnAnalytics_Click" HorizontalAlignment="Left" Height="19" Margin="782,7,0,0" VerticalAlignment="Top" Width="78"/>

        <Popup x:Name="popupBreakdown"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               PopupAnimation="Fade">

            <Border Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10">

                <StackPanel>

                    <TextBlock Text="Score Breakdown"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                    <UniformGrid Columns="4"
                             Rows="2">

                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Trend" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding TrendScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Structure" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding StructureScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Volume" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding VolumeScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Candle" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding CandleScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Setup" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding SetupScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Momentum" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding MomentumScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Volatility" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding VolatilityScore}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Trend Strength" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding TrendStrengthScore}" FontWeight="Bold"/>
                        </StackPanel>

                    </UniformGrid>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>


</Window>
