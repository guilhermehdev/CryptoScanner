<Window x:Class="CryptoScanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="10">

            <TextBlock x:Name="txtWinRate"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtAvgReturn"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtPending"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtEvaluated"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

        </StackPanel>

        <DataGrid x:Name="dgRanking"
              Grid.Row="1"
              AutoGenerateColumns="False"
              IsReadOnly="True">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="STRONG BUY">
                            <Setter Property="Background"
                                Value="LightGreen"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="BUY">
                            <Setter Property="Background"
                                Value="LightBlue"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="WATCH">
                            <Setter Property="Background"
                                Value="Khaki"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" />
                <DataGridTextColumn Header="Preço" Binding="{Binding CloseFormatted}" />
                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F2}" />
                <DataGridTextColumn Header="Elite" Binding="{Binding EliteText}" />
                <DataGridTextColumn Header="Resistência" Binding="{Binding Resistance}" />
                <DataGridCheckBoxColumn Header="Rompimento" Binding="{Binding IsBreakout}" />
                <DataGridTextColumn Header="Trend" Binding="{Binding TrendDirection}" />
                <DataGridTextColumn Header="Sinal" Binding="{Binding Signal}" />
                <DataGridCheckBoxColumn Header="Consol." Binding="{Binding IsConsolidating}" />
                <DataGridTextColumn Header="Volume Spike" Binding="{Binding VolumeSpike, StringFormat=F2}" />             
                <DataGridTextColumn Header="Res %" Binding="{Binding ResistanceDistance, StringFormat=F1}" />
                <DataGridTextColumn Header="Sup %" Binding="{Binding SupportDistance, StringFormat=F1}" />               
               

            </DataGrid.Columns>

        </DataGrid>

        <DataGrid x:Name="dgHistory"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat=dd/MM HH:mm}" />
                <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" />
                <DataGridTextColumn Header="Entrada" Binding="{Binding Price}" />
                <DataGridTextColumn Header="Score" Binding="{Binding FinalScore}" />
                <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" />
                <DataGridCheckBoxColumn Header="Avaliado" Binding="{Binding Evaluated}" />

            </DataGrid.Columns>

        </DataGrid>
        <Button Content="Backtest BTC" Click="BtnBacktest_Click" HorizontalAlignment="Left" Height="19" Margin="696,7,0,0" VerticalAlignment="Top" Width="78"/>
        <Button x:Name="btAtualizar" Content="Atualizar" HorizontalAlignment="Left" Height="19" Margin="614,7,0,0" VerticalAlignment="Top" Width="77" RenderTransformOrigin="0.509,0.601" Click="btAtualizar_Click"/>

    </Grid>


</Window>
