<Window x:Class="CryptoScanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CryptoScanner.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="10">

            <TextBlock x:Name="txtWinRate"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtAvgReturn"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtPending"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

            <TextBlock x:Name="txtEvaluated"
                   Margin="20,0,0,0"
                   FontWeight="Bold"/>

        </StackPanel>

        <DataGrid x:Name="dgRanking"
              Grid.Row="1"
              AutoGenerateColumns="False"
              IsReadOnly="True">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="STRONG BUY">
                            <Setter Property="Background"
                                Value="LightGreen"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="BUY">
                            <Setter Property="Background"
                                Value="LightBlue"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Signal}"
                                 Value="WATCH">
                            <Setter Property="Background"
                                Value="Khaki"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" />
                <DataGridTextColumn Header="Preço" Binding="{Binding CloseFormatted}" />
                <DataGridTextColumn Header="Final Score" Binding="{Binding FinalScore, StringFormat=F2}" />

                <DataGridTextColumn Header="1H" Binding="{Binding Score1H}" />
                <DataGridTextColumn Header="4H" Binding="{Binding Score4H}" />
                <DataGridTextColumn Header="1D" Binding="{Binding Score1D}" />

                <DataGridTextColumn Header="RSI" Binding="{Binding Rsi, StringFormat=F2}" />
                <DataGridTextColumn Header="RVOL" Binding="{Binding RelativeVolume, StringFormat=F2}" />
                <DataGridTextColumn Header="ATR%" Binding="{Binding AtrPercent, StringFormat=F2}" />

                <DataGridCheckBoxColumn Header="Breakout" Binding="{Binding IsBreakout}" />
                <DataGridTextColumn Header="Resistência" Binding="{Binding Resistance}" />
                <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" />

            </DataGrid.Columns>

        </DataGrid>

        <DataGrid x:Name="dgHistory"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat=dd/MM HH:mm}" />

                <DataGridTextColumn Header="Moeda" Binding="{Binding Symbol}" />

                <DataGridTextColumn Header="Entrada" Binding="{Binding Price}" />

                <DataGridTextColumn Header="Score" Binding="{Binding FinalScore}" />

                <DataGridTextColumn Header="Resultado %" Binding="{Binding OutcomePercent, StringFormat=F2}" />

                <DataGridCheckBoxColumn Header="Avaliado" Binding="{Binding Evaluated}" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>


</Window>
