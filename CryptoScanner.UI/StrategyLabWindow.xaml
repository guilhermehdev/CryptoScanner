<Window x:Class="CryptoScanner.UI.StrategyLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laboratório de estratégias" Width="1320" Height="800" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Laboratório de estratégias · geração inicial" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Somente simulação. Cinco variantes recebem os mesmos candidatos do grid visível. Nenhuma substitui os sinais do scanner automaticamente." Foreground="#B8B8B8" TextWrapping="Wrap" Margin="0,8,0,8"/>
            <TextBlock Text="Cada variante: 10.000 USDT fictícios · 1.000 por entrada · até 5 posições · taxa 0,10% e slippage 0,05% por lado. Cotações a cada 30 s enquanto o app roda." Foreground="#B8B8B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="refresh" Content="Atualizar" Padding="14,5" Click="Refresh_Click"/>
            <Button x:Name="export" Content="Exportar para análise" Padding="14,5" Margin="10,0,0,0" Click="Export_Click"/>
            <Button x:Name="pause" Content="Pausar novas entradas" Padding="14,5" Margin="10,0,0,0" Click="Pause_Click"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#D0D4DA" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Presetes:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cmbLabPreset" Width="230" SelectedIndex="1" Margin="0,0,8,0">
                        <ComboBoxItem Content="Variantes atuais"/>
                        <ComboBoxItem Content="Validado + Exploração + Diagnóstico"/>
                    </ComboBox>
                    <Button Content="Aplicar preset" Padding="8,3" Click="ApplyPreset_Click" Margin="0,0,14,0"/>
                    <TextBlock Text="Parâmetros das variantes · pressão mínima:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="V1" VerticalAlignment="Center"/><TextBox x:Name="txtPressure1" Width="42" Margin="3,0,8,0"/>
                    <TextBlock Text="V2" VerticalAlignment="Center"/><TextBox x:Name="txtPressure2" Width="42" Margin="3,0,8,0"/>
                    <TextBlock Text="V3" VerticalAlignment="Center"/><TextBox x:Name="txtPressure3" Width="42" Margin="3,0,8,0"/>
                    <TextBlock Text="V4" VerticalAlignment="Center"/><TextBox x:Name="txtPressure4" Width="42" Margin="3,0,8,0"/>
                    <TextBlock Text="V5" VerticalAlignment="Center"/><TextBox x:Name="txtPressure5" Width="42" Margin="3,0,12,0"/>
                    <TextBlock Text="Stop ×:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtStop1" Width="42" Margin="0,0,5,0"/><TextBox x:Name="txtStop2" Width="42" Margin="0,0,5,0"/><TextBox x:Name="txtStop3" Width="42" Margin="0,0,5,0"/><TextBox x:Name="txtStop4" Width="42" Margin="0,0,5,0"/><TextBox x:Name="txtStop5" Width="42" Margin="0,0,8,0"/>
                    <Button Content="Aplicar parâmetros" Padding="8,3" Click="ApplyParameters_Click"/>
                </StackPanel>
                <TextBlock Text="V1–V5 correspondem às variantes exibidas abaixo. As alterações afetam novas oportunidades; trades já abertos continuam com os parâmetros originais." Foreground="#B8B8B8" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="summary" Grid.Row="3" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <DataGrid x:Name="variants" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Mutation}"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Variante" Binding="{Binding Name}" Width="210"/>
                <DataGridTextColumn Header="Caixa USDT" Binding="{Binding Cash, StringFormat=F2}" Width="100"/>
                <DataGridTextColumn Header="Patrimônio estimado" Binding="{Binding Equity, StringFormat=F2}" Width="140"/>
                <DataGridTextColumn Header="Retorno líquido %" Binding="{Binding NetReturnPercent, StringFormat=F2}" Width="130"/>
                <DataGridTextColumn Header="Abertas" Binding="{Binding Open}" Width="65"/>
                <DataGridTextColumn Header="Fechadas (N)" Binding="{Binding Closed}" Width="95"/>
                <DataGridTextColumn Header="Vitórias %" Binding="{Binding WinPercent, StringFormat=F1, TargetNullValue=—}" Width="80"/>
                <DataGridTextColumn Header="Queda máx. observada %" Binding="{Binding Drawdown, StringFormat=F2}" Width="165"/>
                <DataGridTextColumn Header="Rejeições" Binding="{Binding Rejected}" Width="75"/>
                <DataGridTextColumn Header="Trades com lacunas" Binding="{Binding Gaps}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <TabControl Grid.Row="5" Margin="0,12,0,0">
            <TabItem Header="Trades experimentais · últimos 200">
                <DataGrid x:Name="trades" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="V" Binding="{Binding VariantId}" Width="40"/>
                        <DataGridTextColumn Header="Ativo" Binding="{Binding Symbol}" Width="100"/>
                        <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="75"/>
                        <DataGridTextColumn Header="Entrada (local)" Binding="{Binding EntryLocal, StringFormat=dd/MM HH:mm:ss}" Width="130"/>
                        <DataGridTextColumn Header="Preço entrada" Binding="{Binding EntryFill, StringFormat=0.########}" Width="110"/>
                        <DataGridTextColumn Header="Stop atual" Binding="{Binding Stop, StringFormat=0.########}" Width="110"/>
                        <DataGridTextColumn Header="Restante" Binding="{Binding Remaining, StringFormat=P0}" Width="80"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="85"/>
                        <DataGridTextColumn Header="Retorno fechado %" Binding="{Binding ClosedReturnPercent, StringFormat=F2, TargetNullValue=—}" Width="130"/>
                        <DataGridTextColumn Header="Última cotação (local)" Binding="{Binding QuoteLocal, StringFormat=dd/MM HH:mm:ss}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Lacuna" Binding="{Binding HasObservationGap}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Testes sem vaga · últimos 200">
                <DataGrid x:Name="shadowTrades" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="V" Binding="{Binding VariantId}" Width="40"/>
                        <DataGridTextColumn Header="Ativo" Binding="{Binding Symbol}" Width="100"/>
                        <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="75"/>
                        <DataGridTextColumn Header="Entrada (local)" Binding="{Binding EntryLocal, StringFormat=dd/MM HH:mm:ss}" Width="130"/>
                        <DataGridTextColumn Header="Preço entrada" Binding="{Binding EntryFill, StringFormat=0.########}" Width="110"/>
                        <DataGridTextColumn Header="Stop atual" Binding="{Binding Stop, StringFormat=0.########}" Width="110"/>
                        <DataGridTextColumn Header="Restante" Binding="{Binding Remaining, StringFormat=P0}" Width="80"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="85"/>
                        <DataGridTextColumn Header="Retorno fechado %" Binding="{Binding ClosedReturnPercent, StringFormat=F2, TargetNullValue=—}" Width="130"/>
                        <DataGridTextColumn Header="Última cotação (local)" Binding="{Binding QuoteLocal, StringFormat=dd/MM HH:mm:ss}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Lacuna" Binding="{Binding HasObservationGap}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Decisões · últimas 200">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="decisions" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ativo" Binding="{Binding Symbol}" Width="100"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="90"/>
                            <DataGridTextColumn Header="Variante" Binding="{Binding VariantId}" Width="70"/>
                            <DataGridTextColumn Header="Horário (local)" Binding="{Binding AtLocal, StringFormat=dd/MM HH:mm:ss}" Width="150"/>
                            <DataGridTextColumn Header="Decisão" Binding="{Binding Decision}" Width="100"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" MinWidth="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedItem.Details, ElementName=decisions}" TextWrapping="Wrap" MaxHeight="120" Margin="8"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
