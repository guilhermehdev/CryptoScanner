<Window x:Class="CryptoScanner.UI.LlmOpinionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico da LLM" Height="620" Width="1200"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Ativo:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSymbolFilter" Width="100" Margin="0,0,12,0" TextChanged="FilterChanged"/>
            <TextBlock Text="Decisão:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbDecisionFilter" Width="120" Margin="0,0,12,0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Todas" IsSelected="True"/>
                <ComboBoxItem Content="COMPRA"/>
                <ComboBoxItem Content="VENDA"/>
                <ComboBoxItem Content="AGUARDAR"/>
                <ComboBoxItem Content="IGNORAR"/>
            </ComboBox>
            <Button Content="Atualizar" Click="BtnRefresh_Click" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Exportar CSV" Click="BtnExport_Click" Padding="10,3"/>
        </WrapPanel>
        <TextBlock x:Name="txtSummary" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"/>
        <DataGrid x:Name="dgOpinions" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                <DataGridTextColumn Header="Ativo" Binding="{Binding Symbol}" Width="85"/>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="80"/>
                <DataGridTextColumn Header="Scanner" Binding="{Binding ScannerSignal}" Width="90"/>
                <DataGridTextColumn Header="Decisão" Binding="{Binding Decision}" Width="90"/>
                <DataGridTextColumn Header="Direção" Binding="{Binding Direction}" Width="80"/>
                <DataGridTextColumn Header="Conf." Binding="{Binding Confidence}" Width="55"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding AnalysisPrice, StringFormat=0.########}" Width="95"/>
                <DataGridTextColumn Header="Entrada" Binding="{Binding Entry, StringFormat=0.########}" Width="95"/>
                <DataGridTextColumn Header="Stop" Binding="{Binding Stop, StringFormat=0.########}" Width="95"/>
                <DataGridTextColumn Header="TP1" Binding="{Binding Tp1, StringFormat=0.########}" Width="95"/>
                <DataGridTextColumn Header="TP2" Binding="{Binding Tp2, StringFormat=0.########}" Width="95"/>
                <DataGridTextColumn Header="Tendência" Binding="{Binding Trend}" Width="100"/>
                <DataGridTextColumn Header="Imagem" Binding="{Binding ImagePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
