<Window x:Class="CryptoScanner.UI.DatabaseMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar dados locais" Width="620" Height="420"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="#E8E8E8">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#555555"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="#555555"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E8E8"/></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="O cache de candles é reutilizável. Sinais, trades simulados, laboratório, LLM e resultados de backtest não são removidos por esta tela." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#C6D8EA"/>
        <GroupBox Grid.Row="1" Header="Armazenamento">
            <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="txtStateDatabase" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtCandleCache" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtPressureHistory" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B8B8B8"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Ações">
            <StackPanel Margin="10">
                <TextBlock Text="Limpar cache de candles remove apenas dados OHLCV baixados para backtests. Backtests futuros baixam novamente somente as faixas que precisarem." TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel><Button Content="Limpar cache de candles e compactar" Click="ClearCandleCache_Click"/><Button Content="Atualizar dados" Click="Refresh_Click"/></WrapPanel>
                <Separator Margin="0,14,0,10" Background="#555555"/>
                <TextBlock Text="Pressão compradora: remove snapshots, preços e resultados anteriores a 365 dias. Use apenas se você não precisar dessa amostra histórica." TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="Manter somente 365 dias de pressão" Click="PrunePressure_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="txtStatus" Margin="0,14,0,0" Foreground="#9FC7A8" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
        <Button Grid.Row="3" Content="Fechar" HorizontalAlignment="Right" Margin="0" Click="Close_Click"/>
    </Grid>
</Window>
